# Database - Using SQLite for development
DATABASE_URL="file:./dev.db"

# For production, use PostgreSQL or MySQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/zhixuan?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Private local novel storage
NOVEL_ROOT="E:/path/to/novels"
MIN_BOOK_SCORE="7.5"

# Initial owner account (set a different password before public deployment)
OWNER_USERNAME="codingCat"
OWNER_PASSWORD="change-this-before-deploy"
OWNER_NICKNAME="老板"

# Identifies the sequential, low-rate cover metadata fetcher
COVER_FETCH_USER_AGENT="zhixuan-library-cover-fetcher/1.0 (private-library; sequential requests)"
