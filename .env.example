# Database - Using SQLite for development
DATABASE_URL="file:./dev.db"



# Private local novel storage
NOVEL_ROOT="E:/path/to/novels"
MIN_BOOK_SCORE="7.5"


# Identifies the sequential, low-rate cover fetcher (Qidian mobile -> QQ Reading -> Douban)
COVER_FETCH_USER_AGENT="zhixuan-library-cover-fetcher/1.0 (private-library; sequential requests)"
# 生产环境默认启用：定时选择一本无真实封面的高仙草作品，单并发低频补全
COVER_AUTO_FETCH="true"
COVER_AUTO_FETCH_INTERVAL_SECONDS="90"
COVER_AUTO_FETCH_INITIAL_DELAY_SECONDS="30"
# 可选；默认使用 <项目目录>/public/covers，容器内默认无需配置
# COVER_ROOT="/app/public/covers"

# Identity is accepted only from the protected local nginx gateway.
PORTAL_ALLOWED_USER=owner
LIBRARY_PUBLIC_URL=https://library.private.xuexikuaile.fun
PORTAL_AUTH_URL=https://auth.private.xuexikuaile.fun
